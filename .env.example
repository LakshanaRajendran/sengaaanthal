# ==========================================
# Frontend Environment Variables (Vercel)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api

# ==========================================
# Backend Environment Variables (Render / PostgreSQL)
# ==========================================
PORT=5000

# Cloud PostgreSQL (Neon)
# Example: postgresql://username:password@ep-sample-123.region.aws.neon.tech/sengaanthal_db?sslmode=require
DATABASE_URL=

# Local PostgreSQL Fallback
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sengaanthal_db

# Security & CORS
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173